Options -Indexes
<IfModule mod_headers.c>
  <FilesMatch "\.(?:css|js)$">
    Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
  </FilesMatch>
</IfModule>
RewriteEngine On
# Root entry points and packaged assets only. Private data and PHP source are denied.
RewriteRule ^$ index.php [END]
RewriteRule ^(?:index|api|setup)\.php$ - [END]
RewriteRule ^assets/([A-Za-z0-9_./-]+)$ public/assets/$1 [END]
RewriteRule ^ - [F,END]
